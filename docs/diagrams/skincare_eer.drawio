<mxGeometry x="300" y="2283" width="160" height="44" as="geometry"/></mxCell><mxCell id="lg_irel" value="ID_REL" style="shape=rhombus;perimeter=rhombusPerimeter;double=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="2277" width="120" height="56" as="geometry"/></mxCell><mxCell id="lg_irel_d" value="Identifying relationship" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="2283" width="160" height="44" as="geometry"/></mxCell><mxCell id="lg_key" value="&lt;u&gt;key&lt;/u&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="2382" width="120" height="36" as="geometry"/></mxCell><mxCell id="lg_key_d" value="Key attribute" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2378" width="160" height="44" as="geometry"/></mxCell><mxCell id="lg_pkey" value="&lt;span style=&quot;border-bottom:1.5px dashed #000&quot;&gt;partial key&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="2382" width="120" height="36" as="geometry"/></mxCell><mxCell id="lg_pkey_d" value="Partial key of a weak entity" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="2378" width="160" height="44" as="geometry"/></mxCell><mxCell id="lg_mv" value="multivalued" style="ellipse;shape=doubleEllipse;margin=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="2477" width="120" height="36" as="geometry"/></mxCell><mxCell id="lg_mv_d" value="Multivalued attribute" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2473" width="160" height="44" as="geometry"/></mxCell><mxCell id="lg_dv" value="derived" style="ellipse;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="2477" width="120" height="36" as="geometry"/></mxCell><mxCell id="lg_dv_d" value="Derived attribute (computed, not stored)" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="2473" width="160" height="44" as="geometry"/></mxCell><mxCell id="lg_comp" value="Composite attribute: an attribute with its own sub-attributes (full_name, skin_profile).&lt;br&gt;Double line: total participation (every instance takes part).&lt;br&gt;Circle &lt;b&gt;d&lt;/b&gt;: disjoint specialization; the subset sign (⊂ or ⊃) on each line opens toward the superclass." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="2555" width="600" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rel" name="Relational schema"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4200" pageHeight="2800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rtitle" value="&lt;b&gt;Relational schema mapped from the EER model&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;PK primary key (underlined), FK foreign key, UQ unique. Crow's-foot ends: bar = exactly one, circle = optional, fork = many.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontSize=22;" vertex="1" parent="1"><mxGeometry x="80" y="25" wid