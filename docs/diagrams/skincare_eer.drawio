adding:0 4px;border-radius:8px&quot;&gt;FK→T26&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;CONSISTS_OF (identifying)&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;relationship&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;R7&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;ROUTINE_STEP.routine_id (part of PK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;&lt;span style=&quot;border:1px dashed #82b366;color:#82b366;font-weight:bold;padding:0 4px;border-radius:8px&quot;&gt;FK→T26&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;USES (N:1)&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;relationship&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;R4&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;border-bottom:1px solid #dddddd&quot;&gt;ROUTINE_STEP.product_id&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;margin-top:8px;font-size:12px&quot;&gt;&lt;b&gt;Rules&lt;/b&gt; (same numbering as the note &quot;Mapping rules applied&quot; of the relational schema)&lt;br&gt;R1 entity to table, key to primary key&lt;br&gt;R2 composite attribute flattened&lt;br&gt;R3 derived attribute not stored&lt;br&gt;R4 1:N relationship: foreign key on the N side&lt;br&gt;R5 M:N relationship: junction table with its attributes&lt;br&gt;R6 multivalued attribute: own table&lt;br&gt;R7 weak entity: owner key + partial key&lt;br&gt;R8 specialization: one table per class, shared key&lt;br&gt;R9 1:1 relationship: unique foreign key&lt;br&gt;R10 optional 1:N: own table (no NULL, BCNF)&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;fillColor=#ffffff;strokeColor=#999999;spacing=0;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="3240" y="3040" width="1120" height="1024.8000000000002" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>