x="1040" y="2473" width="160" height="44" as="geometry"/></mxCell><mxCell id="lg_comp" value="Composite attribute: an attribute with its own sub-attributes (full_name, skin_profile).&lt;br&gt;Double line: total participation (every instance takes part).&lt;br&gt;Circle &lt;b&gt;d&lt;/b&gt;: disjoint specialization; the subset sign (⊂ or ⊃) on each line opens toward the superclass." style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="2555" width="600" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="rel" name="Relational schema"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4200" pageHeight="2800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="rtitle" value="&lt;b&gt;Relational schema mapped from the EER model, normalized to BCNF&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;PK primary key (underlined), FK foreign key, UQ unique. Crow's-foot ends: bar = exactly one, circle = optional, fork = many.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontSize=22;" vertex="1" parent="1"><mxGeometry x="80" y="25" width="1400" height="70" as="geometry"/></mxCell><mxCell id="t_USER" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; style=&quot;background:#dae8fc;font-weight:bold;text-align:center;font-size:13px;padding:6px;border-bottom:1px solid #6c8ebf&quot;&gt;USER&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:46px;padding:1px 5px;font-weight:bold;color:#6c8ebf&quot;&gt;PK&lt;/td&gt;&lt;td style=&quot;padding:1px 4px&quot;&gt;&lt;u&gt;user_id&lt;/u&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 5px;color:#777777;text-align:right&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td styl